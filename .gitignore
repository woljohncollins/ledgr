# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
/.next/
/out/
/build
next-env.d.ts

# Production
/dist

# Desktop build output (the Electron/PGlite branch, feat/desktop-electron-pglite).
# The entries above are root-anchored, so desktop's copies weren't covered and a
# build left ~19k untracked files (1.2GB) sitting in the working tree after a
# branch switch. Artifact paths only, never the whole /desktop dir, so real
# source on that branch still shows up as untracked when it should.
/desktop/node_modules/
/desktop/dist/
/desktop/release/
/desktop/web/.next/
/desktop/web/out/

# Environment / secrets (NEVER commit real values; keep .env.example tracked)
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Satellite-instance roster: holds other people's connection strings.
# instances.example.json is the tracked template.
instances.local.json

# Local-peer supervisor config: holds the sync device token + owner email.
# supervisor/config.example.json is the tracked template.
supervisor/config.json
supervisor/config.*.json
!supervisor/config.example.json

# Vercel
.vercel

# Drizzle (keep migrations tracked; ignore transient introspection output if any)
# /drizzle is committed on purpose; uncomment below only if you generate scratch output there
# /drizzle/meta/_journal_tmp.json

# Testing
/coverage

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# TypeScript
*.tsbuildinfo

# Misc
.cache/
tmp/

.vercel
.env*
!.env.example
.claude/
ty-docs/

# Prod-data backups written by one-shot migration scripts (ADR-144 etc.)
scripts/backups/
plans/

# impeccable (design plugin): local-only. .claude/ is already ignored above; these
# are the plugin's other harness mirrors + working data. Keep plugin code/config
# out of the repo. PRODUCT.md / DESIGN.md live at the root and ARE committed.
.agents/
.codex/
.github/skills/
.github/hooks/
.impeccable/
ledgr-icon.png

# Throwaway verification scaffolding (scripts/tmp-*.mts). Committed by accident
# twice; a "git add -A" during a browser check should never sweep these in.
scripts/tmp-*
