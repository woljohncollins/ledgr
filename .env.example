# Ledgr environment variables
# Copy this file to .env.local (gitignored) and fill in real values.
# Never commit real secrets. Keep this template and the runbook.md table in sync.

# --- Database (Neon) ---
# Use the POOLER connection string, never a direct connection (serverless requirement).
# Neon dashboard -> Connection Details -> Pooled connection.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/ledgr?sslmode=require"

# --- Auth (Clerk) ---
# Clerk dashboard -> API Keys. Microsoft is configured as the only interactive
# sign-in method; sign-ups are restricted (single-user v1).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# The in-app sign-in page (src/app/sign-in). No sign-up page: sign-ups are off.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"

# --- File storage (Cloudflare R2) ---
# Cloudflare dashboard -> R2. S3-compatible credentials.
# The bucket is PRIVATE (ADR-231) and must stay that way: reads are served by
# /files/<id>, which checks the owner's session (or a live share token for the
# attachment's parent item) and 302s to a short-lived signed URL. There is no
# R2_PUBLIC_BASE_URL and no public dev URL or custom domain to bind — adding one
# would make every attachment world-readable again.
# All four are required; with any missing, uploads report "storage not configured".
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="ledgr"
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"

# --- Microsoft Graph (OneDrive export now; calendar + email-in in Phase 2) ---
# Azure portal -> App registrations: app-only client credentials (ADR-017).
# The export needs application permission Files.ReadWrite.All with admin
# consent; setup steps in runbook.md §1b.
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
# Whose OneDrive receives the export tree (Brandon's UPN/email) and the
# folder inside it that holds /Export (default "Ledgr" -> /Ledgr/Export/...).
ONEDRIVE_EXPORT_UPN=""
ONEDRIVE_EXPORT_ROOT="Ledgr"
# Mailbox whose calendar/mail the app-only Phase 2 jobs read. Optional:
# defaults to ONEDRIVE_EXPORT_UPN (same person). The Exchange scopes
# (Calendars.Read, Mail.Read) need an Application Access Policy restricting
# this app to this mailbox; setup in runbook.md §1c.
GRAPH_MAILBOX_UPN=""

# --- MCP server (Phase 3, slice 36) ---
# Whose users row the MCP server (POST /api/mcp) acts for. Optional: defaults to
# ONEDRIVE_EXPORT_UPN / GRAPH_MAILBOX_UPN (same person). Needs an `mcp`-scoped
# entry in LEDGR_API_TOKENS to be reachable. Setup: runbook.md §1f.
LEDGR_MCP_OWNER_UPN=""

# --- Tasks adapter (ADR-073/081) ---
# Which task engine this instance uses. Default (unset / anything but "todoist")
# = NATIVE: Ledgr owns tasks end to end (recurrence, scheduling, focus, the ICS
# reminder feed, offline capture) with no external sync. Set to "todoist" (and
# configure TODOIST_TOKEN below) to opt into the optional Todoist sync instead.
TASKS_ADAPTER=""

# --- Todoist (OPTIONAL adapter — Phase 2 slice 25; opt in via TASKS_ADAPTER=todoist) ---
# Personal API token: Todoist -> Settings -> Integrations -> Developer.
TODOIST_TOKEN=""
# The Todoist app's client secret, used to verify webhook HMAC signatures.
# Todoist Developer console -> your app -> App Service OAuth / client secret.
TODOIST_CLIENT_SECRET=""
# Optional: which users-row UPN owns the Todoist account for the machine paths
# (cron, webhook). Defaults to ONEDRIVE_EXPORT_UPN (same person).
TODOIST_OWNER_UPN=""

# --- Web Push notifications (Phase 2, slice 30) ---
# VAPID keypair for Web Push (morning agenda, meeting-prep-ready). Generate
# once with `node scripts/make-vapid-keys.mjs`; the public key is also the
# applicationServerKey the browser subscribes with. Setup: runbook.md §1e.
# Without these, /api/push reports unconfigured and the notify crons 503.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for the push service (RFC 8292 `sub`): mailto: or https URL.
VAPID_SUBJECT="mailto:brandoncollins@edgewoodcommunity.org"

# --- GitHub (Changelog + shared collab notes) ---
# Powers the in-app Changelog (reads the repo's commit history live) and the
# shared collab-notes scratchpad (reads + commits a file in the repo). Git is the
# shared medium across the two separate deploys, so both builders point at the
# same repo and each see the other's pushes + notes. Reads need no token: a
# public repository's commits, compares, and file contents are readable
# anonymously, so the Changelog and "am I current?" work with nothing set.
# Only writes need GITHUB_TOKEN: the shared collab notes, and a satellite's
# fork merge. Without it those show a "not connected" note. Setup: runbook.md §1g.
# A classic PAT (repo scope) or a fine-grained token with Contents read+write.
GITHUB_TOKEN=""
# owner/repo. Defaults to strategicli/ledgr.
GITHUB_REPO="strategicli/ledgr"
# Branch whose commit history feeds the Changelog (the deploy branch).
GITHUB_BRANCH="main"
# Branch the notes file lives on. Defaults to GITHUB_BRANCH. Point it at a
# non-deployed branch (e.g. "collab-notes", auto-created on first write) so
# saving a note doesn't trigger a Vercel rebuild.
GITHUB_NOTES_BRANCH=""
# Path of the committed notes file.
GITHUB_NOTES_PATH="COLLAB_NOTES.md"

# --- Self-update (Build → Updates) ---
# Whether THIS instance may pull the latest code from Build → Updates. Only
# meaningful on a SATELLITE instance: one whose Vercel project deploys from a
# FORK of the shared repo rather than from the repo itself. An instance that
# deploys from the shared repo already receives every push automatically and
# shows "nothing to pull" here regardless of this setting.
#
#   unset / "off"  Status only. The page reports when a newer version exists but
#                  offers no button. The safe default: an instance can't change
#                  what it runs unless someone deliberately allowed it.
#   "safe"         Button enabled, EXCEPT for an update that changes anything
#                  under drizzle/ (a schema change), which is handed back to a
#                  builder. Correct when the host runs the plain `npm run build`.
#   "on"           Button always enabled. ONLY correct when this instance's build
#                  command is `npm run build:satellite`, which migrates the
#                  database before building — otherwise an update carrying a
#                  migration deploys code the schema cannot answer, and a failed
#                  migration would take the instance down instead of aborting the
#                  build. With build:satellite, a bad migration fails the build
#                  and the previous working deploy stays live.
LEDGR_SELF_UPDATE=""
# Which repo this instance deploys from, as owner/repo. Optional: normally
# detected from Vercel's VERCEL_GIT_REPO_OWNER / VERCEL_GIT_REPO_SLUG, so a
# satellite needs nothing here. Set it only to override that detection.
# On a local install this is not needed either way: the repository named in
# Build → Updates → Update policy (update-policy.json) always wins there.
LEDGR_UPDATE_REPO=""
# Token used to pull updates into THIS instance's own repo. Optional: defaults
# to GITHUB_TOKEN. Needs Contents: read+write on the fork (upstream is public,
# so reading it needs nothing special). Set this separately when the instance's
# GITHUB_TOKEN belongs to someone who can't write to that fork.
LEDGR_UPDATE_TOKEN=""

# --- Machine-to-machine tokens (MCP server, cron, webhooks) ---
# Scoped, revocable tokens separate from Clerk; only hashes are stored here.
# Comma-separated entries of name:scope1+scope2:sha256hex, generated with
#   node scripts/make-token.mjs <name> <scope,scope,...>
# Scopes in use: `cron` (scheduled jobs), `diag` (ping), `mcp` (the Claude MCP
# server at /api/mcp — runbook.md §1f), `api` (the external HTTP API at
# /api/machine/items — app integrations / crons like Savor pushing items in,
# ADR-066). Rotation/revocation flow: runbook.md §3.
LEDGR_API_TOKENS=""

# MCP OAuth shim (ADR-117): HMAC signing secret that lets the MCP server be added
# as a custom connector in claude.ai web + the Claude mobile apps (which are
# OAuth-only, no token field). Without it, those clients can't connect (the
# /.well-known discovery routes 404) and the manual-token clients are unaffected.
# Rotating it is the OAuth revocation kill switch. Any high-entropy string:
#   openssl rand -hex 32
# NOTE: also signs the browser-minted MCP tokens (ADR-160, AI & MCP page), so
# rotating revokes those too.
LEDGR_OAUTH_SECRET=""

# Web-clipper token secret (ADR-160): HMAC signing secret for browser-minted
# "Save from the web" clipper tokens (User Settings → Save from the web). Kept
# SEPARATE from LEDGR_OAUTH_SECRET on purpose so the clipper has its own kill
# switch — rotating this revokes every clipper token at once without touching
# MCP or the phone connector. Without it, the Generate button is disabled and
# only pasted CLI/static api tokens work. Any high-entropy string:
#   openssl rand -hex 32
LEDGR_CLIPPER_SECRET=""

# App API token secret (ADR-179): HMAC signing secret for browser-minted app
# tokens (Build → API Tokens) — the `api`-scoped credential you hand to an
# outside app that pushes data into Ledgr over /api/machine/*. A THIRD secret,
# separate from both of the above, so rotating it revokes every app token
# without touching MCP, the phone connector, or the web clipper. Without it,
# the Generate button on that page is disabled and only pasted CLI/static api
# tokens work. Any high-entropy string:
#   openssl rand -hex 32
LEDGR_APP_SECRET=""

# Whose users row the external HTTP API (/api/machine/items) acts for. Optional:
# defaults to ONEDRIVE_EXPORT_UPN / GRAPH_MAILBOX_UPN (same person), and to
# DEV_USER_EMAIL in dev. Needs an `api`-scoped entry in LEDGR_API_TOKENS.
LEDGR_API_OWNER_UPN=""

# --- Transcription (meeting recording v1b, ADR-088) ---
# Optional. Enables audio upload → auto-transcription on a meeting (the paste
# path works without it). Behind the transcription provider seam; the first
# adapter is AssemblyAI (bundled speaker diarization, takes long files by URL).
# Set ASSEMBLYAI_API_KEY to turn it on. TRANSCRIPTION_ADAPTER selects the
# adapter (default "assemblyai"); set it to "none" to disable even with a key.
TRANSCRIPTION_ADAPTER=""
ASSEMBLYAI_API_KEY=""

# --- App config ---
# Toggles verbose errors, query timings, and sync/matcher decisions. Off (false) in normal use.
DEBUG_MODE="false"
# FALLBACK IANA timezone. The owner's timezone is now a per-user setting (User
# Settings → Timezone, stored in users.settings), resolved by getAppTimezone().
# This env var is only the fallback used before an owner is known or when the
# owner hasn't picked one; it defaults to America/New_York when unset. The
# server runs in UTC, so day boundaries must always be computed against the
# resolved zone, never assumed.
LEDGR_TIMEZONE="America/New_York"
# Base URL of the deployed app (used for absolute links, share URLs, callbacks).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Dev-only auth stand-in (ADR-006): when the Clerk keys above are UNSET and
# NODE_ENV is development, the app treats this email as the signed-in user so
# UI can be exercised locally without a Microsoft sign-in. Ignored in
# production builds. Leave empty normally.
DEV_USER_EMAIL=""
# Which email `npm run db:seed` creates the owner row for. Falls back to
# DEV_USER_EMAIL, then to Brandon's address — so a correctly configured dev
# environment needs nothing here. Set it when seeding an instance whose sign-in
# identity differs from DEV_USER_EMAIL: seeding the WRONG address creates an owner
# nobody signs in as, and every page then renders its null-owner state.
SEED_OWNER_EMAIL=""

# --- Sync (local hub/spoke, phase 1) ---
# Arms the in-process sync loop on a LOCAL PEER (spoke). Leave all of these
# unset on the cloud hub and on any instance not opted into sync — the loop
# only starts when LEDGR_SYNC_HUBS is set (src/instrumentation.ts).
# Ordered, comma-separated hub base URLs; the client walks the list on failure
# (that walk is the backup-hub behavior).
LEDGR_SYNC_HUBS=""
# This device's token, minted on the hub (its sha256 hash lives on the hub's
# sync_peers row; revocation is a row flip on the hub, no redeploy).
LEDGR_SYNC_TOKEN=""
# Optional cadence knobs (ms): push soon after a write, pull on an interval.
LEDGR_SYNC_PUSH_DEBOUNCE_MS="2000"
LEDGR_SYNC_PULL_MS="10000"

# --- Local peer runtime (LH2, ADR-206; normally set BY the supervisor) ---
# The supervisor (supervisor/ledgr-supervisor.mjs) assembles all of these into
# the app's env from supervisor/config.json — nothing to set by hand unless
# running `next start` locally without it.
# The no-login local owner identity (plan decision 5). Only honored when Clerk
# is NOT configured and this is NOT a deployed Vercel env (ADR-184 fail-closed
# is unchanged); must match the owner's users.email.
LEDGR_LOCAL_OWNER_EMAIL=""
# The supervisor's data dir. Its presence (off Vercel) is what routes the
# /build/updates "Update now" button to the supervisor signal file instead of
# the GitHub merge path. Unset everywhere else.
LEDGR_SUPERVISOR_DIR=""
# The commit the running local build was made from; stamped by the supervisor
# so the updates card can report code currency on local peers.
LEDGR_BUILD_SHA=""
